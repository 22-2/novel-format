{
  "name": "@22-2/novel-format",
  "version": "1.2.6",
  "type": "module",
  "private": false,
  "description": "Text formatting utilities for novels (formatting, markdown helpers)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "release": "release-it"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/22-2/novel-format.git"
  },
  "keywords": [
    "novel",
    "format",
    "markdown",
    "text"
  ],
  "author": "22-2",
  "license": "MIT",
  "devDependencies": {
    "release-it": "^21.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.13.0",
  "publishConfig": {
    "access": "public"
  }
}
